{
  "name": "connect-rpc",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server-ts",
    "packages/gen-ts",
    "packages/contract-test"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test:unit": "bun run --filter @connect-rpc/web --filter @connect-rpc/server-ts test",
    "test:contract": "bun run --filter @connect-rpc/contract-test test",
    "proto:lint": "cd packages/proto && buf lint",
    "generate": "cd packages/proto && buf generate",
    "test:go": "docker run --rm -v \"$PWD/apps/server-go\":/src -w /src golang:1.26-alpine go test ./..."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "typescript": "^7.0.2"
  }
}
